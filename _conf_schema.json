{
  "api_key": {
    "description": "MiniMax API Key",
    "type": "string",
    "hint": "MiniMax API key. Requests use Authorization: Bearer and the API host selected below.",
    "obvious_hint": true,
    "secret": true,
    "default": ""
  },
  "api_base": {
    "description": "API host",
    "type": "string",
    "hint": "Save, then reopen this page. The voice list is loaded from the selected host, and the API key must be issued for that host.",
    "options": ["https://api.minimax.io", "https://api.minimax.cn"],
    "labels": ["International", "China"],
    "subtitles": ["https://api.minimax.io", "https://api.minimax.cn"],
    "default": "https://api.minimax.io"
  },
  "model": {
    "description": "Model",
    "type": "string",
    "hint": "Speech model sent to T2A. HD costs more than Turbo on both hosts.",
    "options": [
      "speech-2.8-hd",
      "speech-2.8-turbo",
      "speech-2.6-hd",
      "speech-2.6-turbo",
      "speech-02-hd",
      "speech-02-turbo",
      "speech-01-hd",
      "speech-01-turbo"
    ],
    "labels": [
      "Speech 2.8 HD",
      "Speech 2.8 Turbo",
      "Speech 2.6 HD",
      "Speech 2.6 Turbo",
      "Speech 02 HD",
      "Speech 02 Turbo",
      "Speech 01 HD",
      "Speech 01 Turbo"
    ],
    "subtitles": [
      "Higher quality",
      "Faster and lower cost",
      "Previous HD",
      "Previous Turbo",
      "Older HD",
      "Older Turbo",
      "Oldest HD",
      "Oldest Turbo"
    ],
    "default": "speech-2.8-hd"
  },
  "reply_mode": {
    "description": "Reply mode",
    "type": "string",
    "hint": "Text and voice sends both. Voice only drops the text when the whole reply can be spoken. Smart speaks alone when the model, a voice message, or a keyword asks for it.",
    "options": ["both", "voice", "smart"],
    "labels": ["Text and voice", "Voice only", "Smart"],
    "default": "both"
  },
  "smart_agent": {
    "description": "Let the model choose",
    "type": "bool",
    "hint": "Adds one instruction on QQ official chats and OneBot (aiocqhttp, including NapCat): start a reply with <voice-only/> when it is better heard than read. The marker is removed before the message is sent.",
    "default": true,
    "condition": {
      "reply_mode": "smart"
    }
  },
  "smart_mirror_voice": {
    "description": "Answer voice with voice",
    "type": "bool",
    "hint": "When the user sends a voice message, reply with voice only.",
    "default": true,
    "condition": {
      "reply_mode": "smart"
    }
  },
  "smart_keywords": {
    "description": "Voice keywords",
    "type": "string",
    "hint": "If the user's message contains one of these, reply with voice only. Separate phrases with commas.",
    "default": "语音,说给我听,读给我听,念给我听,voice",
    "condition": {
      "reply_mode": "smart"
    }
  },
  "smart_fallback": {
    "description": "When smart does not trigger",
    "type": "string",
    "hint": "Used when the model, the user's voice, and the keywords all stay quiet. Text only skips the speech call.",
    "options": ["both", "text"],
    "labels": ["Text and voice", "Text only"],
    "default": "both",
    "condition": {
      "reply_mode": "smart"
    }
  },
  "language": {
    "description": "Language",
    "type": "string",
    "hint": "The voice list updates when this changes. Taken from the voice id prefix.",
    "options": [
